#!/bin/sh
# Shared preflight: structured local IPP, not localized lpstat output.
set -eu
LC_ALL=C
export LC_ALL
queue=HP_LaserJet_P1102_Native
queue_state=$("$(/usr/bin/dirname "$0")/p1102-queue-check") || exit 1
case "$queue_state" in
    present|absent) ;;
    *) printf '%s\n' 'Unexpected queue-check result. No queue changes were made.' >&2; exit 1 ;;
esac
